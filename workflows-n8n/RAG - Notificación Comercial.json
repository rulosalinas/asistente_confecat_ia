    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH lead_actual AS (\n    SELECT\n        id,\n        session_id,\n        nombre,\n        empresa,\n        telefono,\n        email\n    FROM leads\n    WHERE session_id = $1\n    ORDER BY id DESC\n    LIMIT 1\n)\n\nSELECT\n    l.id AS lead_id,\n    l.session_id,\n    l.nombre,\n    l.empresa,\n    l.telefono,\n    l.email,\n\n    COALESCE(\n        jsonb_agg(\n            h.message\n            ORDER BY h.id\n        ) FILTER (WHERE h.id IS NOT NULL),\n        '[]'::jsonb\n    ) AS historial\n\nFROM lead_actual l\n\nLEFT JOIN n8n_chat_histories h\n    ON h.session_id = l.session_id\n\nGROUP BY\n    l.id,\n    l.session_id,\n    l.nombre,\n    l.empresa,\n    l.telefono,\n      l.email;",
        "options": {
          "queryReplacement": "{{ $json.session_id }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
