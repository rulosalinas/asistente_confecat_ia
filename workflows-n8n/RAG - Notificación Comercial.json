    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ultima_compra AS (\n    SELECT\n        id,\n        session_id,\n        lead_id,\n        desc_producto,\n        codigo,\n        cantidad,\n        precio,\n        talle,\n        cuit,\n        razon_social,\n        direccion_envio,\n        condicion_iva,\n        f_creacion_c\n    FROM compras\n    WHERE session_id = $1\n    ORDER BY id DESC\n    LIMIT 1\n),\n\nlead_actual AS (\n    SELECT\n        id,\n        session_id,\n        nombre,\n        empresa,\n        telefono,\n        email\n    FROM leads\n    WHERE session_id = $1\n    ORDER BY id DESC\n    LIMIT 1\n)\n\nSELECT\n    c.id AS compra_id,\n    c.session_id,\n\n    COALESCE(c.lead_id, l.id) AS lead_id,\n\n    c.desc_producto AS producto,\n    c.codigo,\n    c.cantidad,\n    c.precio,\n    c.talle,\n\n    c.cuit,\n    c.razon_social,\n    c.direccion_envio,\n    c.condicion_iva,\n\n    l.nombre,\n    l.empresa,\n    l.telefono,\n    l.email,\n\n    c.f_creacion_c AS fecha_compra\n\nFROM ultima_compra c\nLEFT JOIN lead_actual l\n    ON l.session_id = c.session_id;",
        "options": {
          "queryReplacement": "{{ $json.session_id }}"
        }
      },
