}

.chat-input-send-button:hover{
    color:#1565C0 !important;
}

/* ========= BOTON FLOTANTE ========= */

.chat-window-toggle{
    background:#1E88E5 !important;
    color:white !important;
}

/* ========= TIPOGRAFIA ========= */

.chat-window{
    font-family:'Segoe UI',sans-serif !important;
}

</style>


<div id="n8n-chat"></div>

<script type="module">
import { createChat } from 'https://cdn.jsdelivr.net/npm/@n8n/chat/dist/chat.bundle.es.js';

createChat({
	
    webhookUrl: 'http://192.168.5.231:5678/webhook/a4d9a414-c929-486c-b394-4eac06aa004e/chat' ,

    webhookConfig: {
        method: 'POST',
        headers: {}
    },

    target: '#n8n-chat',

    mode: 'window',

    chatInputKey: 'chatInput',
    chatSessionKey: 'sessionId',

    loadPreviousSession: false,

    metadata: {},

    showWelcomeScreen: false,

    defaultLanguage: 'es',

    initialMessages: [
        '¡Bienvenido a Confecat!',
        'Soy AVI. ¿En qué puedo ayudarte hoy?'
    ],

    i18n: {
        es: {
            title: 'AVI CONFECAT',
            subtitle: 'Asistente Virtual Inteligente',
            footer: '',
            getStarted: 'Nueva conversación',
            inputPlaceholder: 'Escriba su consulta...'
        }
    },

    enableStreaming: false

});
</script>

