    background:#1E88E5 !important;
    color:white !important;
    border-radius:12px !important;
}

.chat-message-from-user p{
    color:white !important;
}

/* ========= MENSAJES DEL BOT ========= */

.chat-message-from-bot{
    background:white !important;
    border-radius:12px !important;
}

.chat-message-from-bot p{
    color:#222 !important;
}

