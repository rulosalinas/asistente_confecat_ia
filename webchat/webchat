<link href="https://cdn.jsdelivr.net/npm/@n8n/chat/dist/style.css" rel="stylesheet">


<style>

/* ========= COLORES ========= */

:root{
    --confecat-blue:#1E88E5;
    --confecat-blue-dark:#1565C0;
}

/* ========= ENCABEZADO ========= */

.chat-header{
    background:#1E88E5 !important;
    color:white !important;
}

.chat-header h1{
    color:white !important;
}

.chat-header p{
    color:white !important;
}

/* ========= MENSAJES DEL USUARIO ========= */

